# Cosmos — variables d'environnement (serveur Vercel et développement local via `vercel dev`)
# Sans SUPABASE_URL / SUPABASE_ANON_KEY, l'app tourne en mode local (localStorage), sans connexion.

# Projet Supabase (Settings › API)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=            # clé publique (anon / publishable) — envoyée au navigateur
SUPABASE_SERVICE_ROLE_KEY=    # clé secrète — serveur uniquement (fonctions api/, script de création d'utilisateur)

# Assistant IA du volet gauche (api/assist.js)
ANTHROPIC_API_KEY=

# Local seulement (jamais sur Vercel) : mot de passe de la base, utilisé par `supabase db push`
SUPABASE_DB_PASSWORD=
